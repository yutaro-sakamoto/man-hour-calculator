{
  "name": "mhc-web",
  "version": "0.1.0",
  "private": true,
  "description": "工数見積もりアプリのフロントエンド (単一 HTML に埋め込む)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=77 \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
