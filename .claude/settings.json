{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-check.sh",
            "timeout": 30,
            "statusMessage": "文書と仕様のずれを見ています"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/journal-check.sh",
            "timeout": 10,
            "statusMessage": "貯めた知見を昇格し忘れていないか見ています"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo xtask build:*)",
      "Bash(cargo kani:*)",
      "Bash(cargo mutants:*)",
      "Bash(npm --prefix web run:*)",
      "Bash(npx playwright test:*)",
      "Bash(make help)",
      "Bash(make check:*)",
      "Bash(make test:*)",
      "Bash(make test-rust:*)",
      "Bash(make test-web:*)",
      "Bash(make lint:*)",
      "Bash(make fmt-check:*)",
      "Bash(make sync:*)",
      "Bash(make build:*)",
      "Bash(make e2e:*)",
      "Bash(make coverage:*)",
      "Bash(make complexity:*)",
      "Bash(./scripts/check-sync.sh:*)",
      "Bash(./scripts/coverage.sh:*)",
      "Bash(./scripts/complexity.sh:*)",
      "Bash(./spec/check.sh:*)",
      "Bash(./scripts/journal.sh:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh issue delete:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
